[
  {
    "image": "第19話_02_003.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "呃嗯…",
    "japanese": "ん……？",
    "target": "片段1/分镜3"
  },
  {
    "image": "第19話_02_003.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "怎么回事…",
    "japanese": "どういうことだ……。",
    "target": "片段1/分镜3"
  },
  {
    "image": "第19話_03_001.jpg",
    "speaker": "全盔守卫",
    "kind": "dialogue",
    "source_text": "AAAH!",
    "japanese": "うわあっ！",
    "target": "片段1/分镜4"
  },
  {
    "image": "第19話_03_001.jpg",
    "speaker": "受困少女",
    "kind": "dialogue",
    "source_text": "KYAA!!",
    "japanese": "きゃあっ！",
    "target": "片段1/分镜4"
  },
  {
    "image": "第19話_03_003.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "因为前面很吵才着急忙慌赶到的。",
    "japanese": "この先が騒がしかったから、慌てて来たんだけど。",
    "target": "片段2/分镜1"
  },
  {
    "image": "第19話_04_001.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "你",
    "japanese": "お前、",
    "target": "片段2/分镜2"
  },
  {
    "image": "第19話_04_001.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "是谁？",
    "japanese": "誰だ？",
    "target": "片段2/分镜2"
  },
  {
    "image": "第19話_04_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "真是走运",
    "japanese": "ついてるなあ。",
    "target": "片段3/分镜1"
  },
  {
    "image": "第19話_04_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "今天到底是什么日子？",
    "japanese": "今日は一体、何の日だろう？",
    "target": "片段3/分镜1"
  },
  {
    "image": "第19話_04_003.jpg",
    "speaker": "全盔守卫",
    "kind": "inner",
    "source_text": "得,得救了…骑士在关键时刻赶来…",
    "japanese": "た、助かった……。騎士がぎりぎりで来てくれた……。",
    "target": "片段4/分镜1"
  },
  {
    "image": "第19話_04_003.jpg",
    "speaker": "受困少女",
    "kind": "dialogue",
    "source_text": "干,干掉它!!",
    "japanese": "た、倒して！！",
    "target": "片段4/分镜2"
  },
  {
    "image": "第19話_04_003.jpg",
    "speaker": "受困少女",
    "kind": "dialogue",
    "source_text": "他是个疯子！",
    "japanese": "こいつ、頭がおかしいの！",
    "target": "片段4/分镜2"
  },
  {
    "image": "第19話_05_001.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "天…哪…",
    "japanese": "なんて……こった……。",
    "target": "片段5/分镜1"
  },
  {
    "image": "第19話_05_002.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "双马尾…",
    "japanese": "ツインテール……。",
    "target": "片段5/分镜2"
  },
  {
    "image": "第19話_05_002.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "大奶子…",
    "japanese": "でかい胸……。",
    "target": "片段5/分镜2"
  },
  {
    "image": "第19話_05_003.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "你有",
    "japanese": "お前、",
    "target": "片段5/分镜3"
  },
  {
    "image": "第19話_05_003.jpg",
    "speaker": "秃顶男子",
    "kind": "dialogue",
    "source_text": "男朋友吗？",
    "japanese": "彼氏はいるのか？",
    "target": "片段5/分镜3"
  },
  {
    "image": "第19話_06_001.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "咕哝些什么呢？",
    "japanese": "何をぶつぶつ言ってるの？",
    "target": "片段6/分镜1"
  },
  {
    "image": "第19話_06_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "爬到这种边缘地带来你可真有胆。",
    "japanese": "こんな辺境まで来るなんて、いい度胸ね。",
    "target": "片段6/分镜2"
  },
  {
    "image": "第19話_06_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "也可以说愚蠢至极",
    "japanese": "それとも、とんでもない馬鹿なのかな。",
    "target": "片段6/分镜2"
  },
  {
    "image": "第19話_07_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "随便啦",
    "japanese": "まあ、どうでもいいや。",
    "target": "片段7/分镜4"
  },
  {
    "image": "第19話_07_002.jpg",
    "speaker": "董白",
    "kind": "dialogue",
    "source_text": "我会和你玩到尽兴之后宰了你",
    "japanese": "たっぷり遊んでから、殺してあげる。",
    "target": "片段7/分镜4"
  },
  {
    "image": "第19話_08_002.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "你在笑什么？",
    "japanese": "何を笑ってるの？",
    "target": "片段8/分镜1"
  },
  {
    "image": "第19話_08_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "啥？！",
    "japanese": "えっ？！",
    "target": "片段8/分镜2"
  },
  {
    "image": "第19話_08_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "我没笑啊！",
    "japanese": "笑ってないよ！",
    "target": "片段8/分镜2"
  },
  {
    "image": "第19話_08_004.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "就算现在，你也还在笑",
    "japanese": "今だって、まだ笑ってるじゃん。",
    "target": "片段8/分镜3"
  },
  {
    "image": "第19話_09_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "没,没有.我只是觉得即使在被揍了一拳之后…",
    "japanese": "ち、違うよ。殴られたあとでも……、",
    "target": "片段9/分镜1"
  },
  {
    "image": "第19話_09_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "姐姐还是那么漂亮…",
    "japanese": "お姉ちゃんは、やっぱりきれいだなって……。",
    "target": "片段9/分镜1"
  },
  {
    "image": "第19話_09_001.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "发什么神经",
    "japanese": "何言ってんの。",
    "target": "片段9/分镜2"
  },
  {
    "image": "第19話_09_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "HAA…",
    "japanese": "はあ……。",
    "target": "片段10/分镜1"
  },
  {
    "image": "第19話_09_003.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "又怎么了？",
    "japanese": "今度は何？",
    "target": "片段10/分镜1"
  },
  {
    "image": "第19話_09_004.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "我弄丢了通行证…",
    "japanese": "通行証、なくしちゃったし……。",
    "target": "片段10/分镜2"
  },
  {
    "image": "第19話_09_004.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "也是因为我，你才受伤的",
    "japanese": "お姉ちゃんが怪我したのも、私のせいだし。",
    "target": "片段10/分镜2"
  },
  {
    "image": "第19話_10_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "我感觉我除了惹祸一事无成",
    "japanese": "私、迷惑ばかりで、何もできてない。",
    "target": "片段11/分镜1"
  },
  {
    "image": "第19話_10_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "如果那两个进去的人出了什么事…",
    "japanese": "中に入った二人に、何かあったら……。",
    "target": "片段11/分镜1"
  },
  {
    "image": "第19話_10_002.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "如果他们不走运死了，我们就去吃他们的席.",
    "japanese": "運悪く死んだら、葬式でご飯を食べよう。",
    "target": "片段12/分镜1"
  },
  {
    "image": "第19話_10_002.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "你哭的出来吗？",
    "japanese": "泣ける？",
    "target": "片段12/分镜1"
  },
  {
    "image": "第19話_10_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "别乌鸦嘴好吗？",
    "japanese": "縁起でもないこと、言わないで！",
    "target": "片段13/分镜1"
  },
  {
    "image": "第19話_10_003.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "怎么？",
    "japanese": "何？",
    "target": "片段13/分镜1"
  },
  {
    "image": "第19話_10_003.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "他们偷了我们的东西然后进去了，我还要为他们担心吗？",
    "japanese": "私たちの物を盗んで入ったんだよ。心配する必要ある？",
    "target": "片段13/分镜2"
  },
  {
    "image": "第19話_11_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "就,就算这样！你也该在乎他们的生命…!!",
    "japanese": "そ、それでも！命は大事にしてよ！",
    "target": "片段14/分镜1"
  },
  {
    "image": "第19話_11_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "你自己说过这条路很危险的…",
    "japanese": "この道は危険だって、自分で言ったでしょ……。",
    "target": "片段14/分镜1"
  },
  {
    "image": "第19話_11_002.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "够了，我们现在也做不了什么.",
    "japanese": "もういいよ。今は何もできない。",
    "target": "片段15/分镜1"
  },
  {
    "image": "第19話_11_002.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "就算有什么发生了，那个双马尾婊子会想办法解决的.",
    "japanese": "何かあっても、あのツインテールのクソ女が何とかするよ。",
    "target": "片段15/分镜2"
  },
  {
    "image": "第19話_11_004.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "HUH?",
    "japanese": "え？",
    "target": "片段15/分镜4"
  },
  {
    "image": "第19話_12_001.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "好久不见",
    "japanese": "久しぶり。",
    "target": "片段16/分镜1"
  },
  {
    "image": "第19話_12_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "你,你是…？",
    "japanese": "あ、あなたは……？",
    "target": "片段16/分镜1"
  },
  {
    "image": "第19話_12_002.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "既然如此，为何不当魔物猎手？",
    "japanese": "それなら、魔物ハンターにならないか？",
    "target": "片段17/分镜1"
  },
  {
    "image": "第19話_12_002.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "啊哈？",
    "japanese": "え？",
    "target": "片段17/分镜1"
  },
  {
    "image": "第19話_13_001.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "在这世界没有什么工作能比魔物猎手更声名显赫.",
    "japanese": "この世界で、魔物ハンターほど名を上げられる仕事はない。",
    "target": "片段17/分镜2"
  },
  {
    "image": "第19話_13_001.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "只要你能打你就行",
    "japanese": "戦えるなら、それでいい。",
    "target": "片段17/分镜2"
  },
  {
    "image": "第19話_13_002.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "AAAAH!!",
    "japanese": "ああっ！",
    "target": "片段18/分镜1"
  },
  {
    "image": "第19話_13_002.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "你是之前那个大叔!!",
    "japanese": "前に会った、おじさんだ！！",
    "target": "片段18/分镜1"
  },
  {
    "image": "第19話_13_003.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "他是谁？你喜欢这种的？",
    "japanese": "誰？こういうのが好きなの？",
    "target": "片段19/分镜1"
  },
  {
    "image": "第19話_13_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "没有.我刚到这里的时候遇到的他.",
    "japanese": "違うよ。ここに来たばかりの時に会ったの。",
    "target": "片段19/分镜2"
  },
  {
    "image": "第19話_14_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "他推荐我当魔物猎手，所以我才当的.",
    "japanese": "あの人に勧められて、魔物ハンターになったんだ。",
    "target": "片段20/分镜1"
  },
  {
    "image": "第19話_14_001.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "…HMM.",
    "japanese": "ふーん。",
    "target": "片段20/分镜1"
  },
  {
    "image": "第19話_14_002.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "没想到能在这里遇见.",
    "japanese": "ここで会うとはな。",
    "target": "片段20/分镜2"
  },
  {
    "image": "第19話_14_002.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "你肯定也对猎杀魔物很感兴趣！",
    "japanese": "魔物狩りに、すごく興味があるんでしょ！",
    "target": "片段20/分镜2"
  },
  {
    "image": "第19話_14_003.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "你们要去北边？",
    "japanese": "北へ行くのか？",
    "target": "片段21/分镜1"
  },
  {
    "image": "第19話_14_004.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "HUH?",
    "japanese": "え？",
    "target": "片段21/分镜2"
  },
  {
    "image": "第19話_14_004.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "你怎么知道的？",
    "japanese": "どうして知ってるの？",
    "target": "片段21/分镜2"
  },
  {
    "image": "第19話_15_001.jpg",
    "speaker": "黑袍来者",
    "kind": "dialogue",
    "source_text": "跟上.",
    "japanese": "ついて来い。",
    "target": "片段21/分镜3"
  },
  {
    "image": "第19話_15_002.jpg",
    "speaker": "青",
    "kind": "inner",
    "source_text": "？？？",
    "japanese": "……？",
    "target": "片段21/分镜4"
  },
  {
    "image": "第19話_15_002.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "HUH?",
    "japanese": "え？",
    "target": "片段21/分镜4"
  },
  {
    "image": "第19話_15_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "什么情况？",
    "japanese": "どういうこと？",
    "target": "片段22/分镜1"
  },
  {
    "image": "第19話_15_003.jpg",
    "speaker": "春子",
    "kind": "inner",
    "source_text": "……",
    "japanese": "……。",
    "target": "片段22/分镜1"
  },
  {
    "image": "第19話_15_003.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "大叔也是骑士？",
    "japanese": "おじさんも騎士なの？",
    "target": "片段22/分镜1"
  },
  {
    "image": "第19話_16_001.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "这里…是我们进来的地方.",
    "japanese": "ここ、私たちが入ってきた場所だよ。",
    "target": "片段23/分镜1"
  },
  {
    "image": "第19話_16_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "这里有秘密通道之类的东西？",
    "japanese": "秘密の抜け道でもあるの？",
    "target": "片段23/分镜2"
  },
  {
    "image": "第19話_16_001.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "不可能有",
    "japanese": "あるわけない。",
    "target": "片段23/分镜2"
  },
  {
    "image": "第19話_16_002.jpg",
    "speaker": "春子",
    "kind": "inner",
    "source_text": "那么…",
    "japanese": "それで……。",
    "target": "片段24/分镜1"
  },
  {
    "image": "第19話_16_002.jpg",
    "speaker": "春子",
    "kind": "inner",
    "source_text": "为什么他在让我们跟上来之后就站在那里？",
    "japanese": "ついて来いと言ったくせに、どうしてそこで止まってるの？",
    "target": "片段24/分镜1"
  },
  {
    "image": "第19話_18_001.jpg",
    "speaker": "青",
    "kind": "dialogue",
    "source_text": "GAAH!!",
    "japanese": "うわっ！！",
    "target": "片段25/分镜3"
  },
  {
    "image": "第19話_18_001.jpg",
    "speaker": "春子",
    "kind": "dialogue",
    "source_text": "什么情况？！",
    "japanese": "何これ？！",
    "target": "片段25/分镜3"
  },
  {
    "image": "第19話_18_002.jpg",
    "speaker": "青",
    "kind": "inner",
    "source_text": "……!!!!",
